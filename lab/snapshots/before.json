{
  "label": "lab-before-fix",
  "account_id": "123456789012",
  "users": [
    {
      "name": "admin-user",
      "console_access": true,
      "mfa_enabled": true,
      "groups": [
        "Admins"
      ],
      "attached_policies": [],
      "inline_policies": [],
      "access_keys": []
    },
    {
      "name": "lab-dev-intern",
      "console_access": true,
      "mfa_enabled": false,
      "groups": [],
      "attached_policies": [
        "AdministratorAccess",
        "IAMUserChangePassword"
      ],
      "inline_policies": [],
      "access_keys": []
    },
    {
      "name": "lab-app-service",
      "console_access": false,
      "mfa_enabled": false,
      "groups": [],
      "attached_policies": [
        "lab-overly-permissive-policy"
      ],
      "inline_policies": [],
      "access_keys": [
        {
          "id": "key-1",
          "status": "Active",
          "age_days": 0,
          "last_used": null
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "Admins",
      "attached_policies": [
        "AdministratorAccess"
      ],
      "inline_policies": []
    }
  ],
  "roles": [
    {
      "name": "lab-ec2-admin-role",
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "ec2.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "attached_policies": [
        "AdministratorAccess"
      ],
      "inline_policies": []
    }
  ],
  "policies": [
    {
      "name": "lab-overly-permissive-policy",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "*",
            "Resource": "*"
          }
        ]
      }
    }
  ]
}
