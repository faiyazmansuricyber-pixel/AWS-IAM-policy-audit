{
  "label": "lab-after-fix",
  "account_id": "123456789012",
  "users": [
    {
      "name": "admin-user",
      "console_access": true,
      "mfa_enabled": true,
      "groups": [
        "Admins"
      ],
      "attached_policies": [],
      "inline_policies": [],
      "access_keys": []
    },
    {
      "name": "lab-dev-intern",
      "console_access": true,
      "mfa_enabled": true,
      "groups": [
        "lab-developers"
      ],
      "attached_policies": [
        "IAMUserChangePassword"
      ],
      "inline_policies": [],
      "access_keys": []
    },
    {
      "name": "lab-app-service",
      "console_access": false,
      "mfa_enabled": false,
      "groups": [],
      "attached_policies": [
        "lab-app-service-s3-write"
      ],
      "inline_policies": [],
      "access_keys": []
    }
  ],
  "groups": [
    {
      "name": "Admins",
      "attached_policies": [
        "AdministratorAccess"
      ],
      "inline_policies": []
    },
    {
      "name": "lab-developers",
      "attached_policies": [
        "lab-dev-intern-s3-read"
      ],
      "inline_policies": []
    }
  ],
  "roles": [
    {
      "name": "lab-ec2-admin-role",
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "ec2.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "attached_policies": [],
      "inline_policies": [
        {
          "name": "lab-dev-intern-s3-read",
          "document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "ListOneBucket",
                "Effect": "Allow",
                "Action": "s3:ListBucket",
                "Resource": "arn:aws:s3:::lab-dev-data-bucket"
              },
              {
                "Sid": "ReadObjectsInOneBucket",
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::lab-dev-data-bucket/*"
              }
            ]
          }
        }
      ]
    }
  ],
  "policies": [
    {
      "name": "lab-dev-intern-s3-read",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "ListOneBucket",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::lab-dev-data-bucket"
          },
          {
            "Sid": "ReadObjectsInOneBucket",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::lab-dev-data-bucket/*"
          }
        ]
      }
    },
    {
      "name": "lab-app-service-s3-write",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "WriteLogsToOneBucket",
            "Effect": "Allow",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::lab-app-logs-bucket/*"
          }
        ]
      }
    }
  ]
}
